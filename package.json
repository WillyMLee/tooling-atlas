{
  "name": "@willymlee/tooling-atlas",
  "version": "0.8.0",
  "description": "Open-source design references, diagram packets, interaction patterns, and agent workflow skills.",
  "type": "module",
  "license": "MIT",
  "files": ["assets", "modules", "catalog", "skills", "docs"],
  "exports": {
    ".": "./modules/diagram-kit.js",
    "./styles": "./modules/diagram-kit.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/validate.mjs && node scripts/eval.mjs check && node scripts/eval-strategic-ab.mjs --check && node scripts/test-router.mjs && node scripts/test-capture.mjs && node scripts/test-route-events.mjs && node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "eval:plan": "node scripts/eval.mjs plan",
    "eval:check": "node scripts/eval.mjs check",
    "eval:score": "node scripts/eval.mjs score",
    "eval:strategic": "node scripts/eval-strategic-ab.mjs --write",
    "router:test": "node scripts/test-router.mjs",
    "sites:check": "node scripts/check-sites.mjs --write",
    "captures:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-design-crops.ps1",
    "telemetry:route": "node scripts/record-route.mjs",
    "telemetry:summary": "node scripts/summarize-events.mjs",
    "telemetry:test": "node scripts/test-capture.mjs",
    "skills:link": "node scripts/link-skills.mjs",
    "skills:link:dry": "node scripts/link-skills.mjs --dry-run"
  },
  "engines": { "node": ">=20" }
}
